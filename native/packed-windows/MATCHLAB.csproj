<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
<UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
<AssemblyName>MATCHLAB_AZ</AssemblyName><Version>0.9.42</Version>
<ApplicationIcon>../branding/matchlab_icon.ico</ApplicationIcon>
<RuntimeIdentifier>win-x64</RuntimeIdentifier><PublishSingleFile>true</PublishSingleFile>
<SelfContained>true</SelfContained><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
</PropertyGroup>
<ItemGroup>
<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35"/>
<EmbeddedResource Include="../../index.html" LogicalName="ML.index.html"/>
<EmbeddedResource Include="../../styles.css" LogicalName="ML.styles.css"/>
<EmbeddedResource Include="../../app.js" LogicalName="ML.app.js"/>
<EmbeddedResource Include="../../catalog.js" LogicalName="ML.catalog.js"/>
<EmbeddedResource Include="../../featured_media.js" LogicalName="ML.featured_media.js"/>
<EmbeddedResource Include="../../coach_tactics.js" LogicalName="ML.coach_tactics.js"/>
<EmbeddedResource Include="../../assets/icon.svg" LogicalName="ML.assets.icon.svg"/>
<EmbeddedResource Include="../packed/shell.css" LogicalName="ML.shell.css"/>
<EmbeddedResource Include="../packed/shell.js" LogicalName="ML.shell.js"/>
<EmbeddedResource Include="../../install.js" LogicalName="ML.install.js"/>
<EmbeddedResource Include="../../service-worker.js" LogicalName="ML.service-worker.js"/>
<EmbeddedResource Include="../../manifest.webmanifest" LogicalName="ML.manifest.webmanifest"/>
<EmbeddedResource Include="../../assets/pwa-192.png" LogicalName="ML.assets.pwa-192.png"/>
<EmbeddedResource Include="../../assets/pwa-512.png" LogicalName="ML.assets.pwa-512.png"/>
<EmbeddedResource Include="../../assets/pwa-512-maskable.png" LogicalName="ML.assets.pwa-512-maskable.png"/>
</ItemGroup>
</Project>
