# Replace MATCHLAB_HOSTNAME with a DNS name pointing to the VM public IPv4.
# Caddy obtains and renews a Let's Encrypt HTTPS certificate automatically.
MATCHLAB_HOSTNAME {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    reverse_proxy 127.0.0.1:10000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 35s
        }
    }
    log {
        output file /var/log/caddy/matchlab-access.log {
            roll_size 20MiB
            roll_keep 4
            roll_keep_for 168h
        }
    }
}
